{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://sanekt-attendance-backend.onrender.com/api/v1/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://sanekt-attendance-backend.onrender.com/api/v1/auth/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://sanekt-attendance-backend.onrender.com/api/v1/admin/:path*"
    },
    {
      "source": "/attendance/:path*",
      "destination": "https://sanekt-attendance-backend.onrender.com/api/v1/attendance/:path*"
    },
    {
      "source": "/leaves/:path*",
      "destination": "https://sanekt-attendance-backend.onrender.com/api/v1/leaves/:path*"
    },
    {
      "source": "/office/:path*",
      "destination": "https://sanekt-attendance-backend.onrender.com/api/v1/office/:path*"
    },
    {
      "source": "/notifications/:path*",
      "destination": "https://sanekt-attendance-backend.onrender.com/api/v1/notifications/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
