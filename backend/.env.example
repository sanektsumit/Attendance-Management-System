# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas URL)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/attendance_db?retryWrites=true&w=majority

# Security Secrets
JWT_SECRET=your_super_secret_production_jwt_key_here
JWT_EXPIRE=7d

# CORS Allowed Origins (Comma separated URLs of deployed frontend)
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,https://your-app-name.onrender.com

# Optional: Set to true if deploying frontend & backend on the SAME server (Render / Railway Web Service)
SERVE_FRONTEND=true

# SMTP Email Settings (For notifications / OTPs / reset password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Attendance System <noreply@attendancesystem.com>
